{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionDock",
  "version": "0.2.0",
  "identifier": "com.yan.sessiondock",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SessionDock",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#f7f4ee",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
