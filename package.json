{
  "name": "session-dock",
  "version": "0.1.0",
  "private": true,
  "description": "SessionDock — Unified local session manager for AI coding agents",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:1420 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.yan.sessiondock",
    "productName": "SessionDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SessionDock"
    }
  },
  "author": {
    "name": "Yan",
    "email": "yan@local"
  }
}
